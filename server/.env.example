# Ganapathi Gardens Plant Nursery - Backend Environment Variables
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS
# DO NOT COMMIT THE ACTUAL .env FILE TO GITHUB

# Server Port
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Replace <username>, <password>, and cluster details with your MongoDB Atlas database credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/Plant_Nest?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate secure random 32+ character strings)
JWT_USER_SECRET=your_jwt_customer_secret_key_here_change_in_production
JWT_ADMIN_SECRET=your_jwt_admin_secret_key_here_change_in_production

# Default Admin Credentials
ADMIN_EMAIL=admin@ganapathigardens.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Email Dispatch Configuration
# Web3Forms access key for dispatching order alerts to admin
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Direct SMTP Email (Optional - Nodemailer fallback)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password

# AI & RAG Pipeline Configuration (Optional: fallback engine runs automatically if empty)
GEMINI_API_KEY=
OPENAI_API_KEY=
PINECONE_API_KEY=
