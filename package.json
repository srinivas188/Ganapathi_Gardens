{
  "name": "greennest-nursery",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server/server.js",
    "dev:server": "node server/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "build": "npm --prefix frontend run build",
    "install:all": "npm --prefix server install && npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
