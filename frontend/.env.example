# Frontend Environment Variables Template
# When deploying frontend on Netlify, add these in Netlify Site Configuration -> Environment Variables

# Backend API Base URL
# For local development: leave blank or set to /api (Vite proxy forwards to http://localhost:5000)
# For production on Netlify: set to your deployed backend URL (e.g. https://ganapathi-gardens-api.onrender.com/api)
VITE_API_URL=/api

# Web3Forms Public Access Key (for order notification emails to admin)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
